<% content_for :title, "Habits" %>


<div class="habit-list">
  <h1 class="habit-list__title">I want to...</h1>

  <div class="habit-list__row">
    <%= render "habit_list", list_title: "Start", habits: @good_habits %>
    <%= render "habit_list", list_title: "Stop", habits: @bad_habits %>
  </div>
</div>


<%= link_to "New habit", new_habit_path %>

<table class="habit-table">
  <tr>
    <th>Habit</th>
    <th>Yesterday</th>
    <th>Today</th>
  </tr>

  <tr><th class="habit-table__section-title" colspan="3">I want to start</th></tr>

  <% @good_habits.each do |habit| %>
    <% habit_history = habit.history_between(Date.yesterday, Date.today) %>
    <%= render "habit_row", habit: habit, yesterday_data: habit_history.first, today_data: habit_history.last %>
  <% end %>

  <tr><th class="habit-table__section-title" colspan="3">I want to stop</th></tr>

  <% @bad_habits.each do |habit| %>
    <% habit_history = habit.history_between(Date.yesterday, Date.today) %>
    <%= render "habit_row", habit: habit, yesterday_data: habit_history.first, today_data: habit_history.last %>
  <% end %>
</table>



